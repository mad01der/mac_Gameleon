ninja_required_version = 1.3
cxx = c++

cflags = -DTORCH_EXTENSION_NAME=torchac_backend -DTORCH_API_INCLUDE_EXTENSION_H -isystem /Users/lijinyang/Documents/mac_Gameleon/mac_Gameleon/.venv/lib/python3.12/site-packages/torch/include -isystem /Users/lijinyang/Documents/mac_Gameleon/mac_Gameleon/.venv/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /opt/homebrew/opt/python@3.12/Frameworks/Python.framework/Versions/3.12/include/python3.12 -fPIC -std=c++20
post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/Users/lijinyang/Documents/mac_Gameleon/mac_Gameleon/.venv/lib/python3.12/site-packages/torch/lib -lc10 -ltorch_cpu -ltorch -ltorch_python -undefined dynamic_lookup

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc





rule link
  command = $cxx $in $ldflags -o $out

build torchac_backend.o: compile /Users/lijinyang/Documents/mac_Gameleon/mac_Gameleon/.venv/lib/python3.12/site-packages/torchac/backend/torchac_backend.cpp





build torchac_backend.so: link torchac_backend.o

default torchac_backend.so
